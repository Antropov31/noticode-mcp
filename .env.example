# Cloud MCP
ANTRO_HOST=0.0.0.0
ANTRO_PORT=4320
ANTRO_MCP_TOKEN=change-me
ANTRO_RUNNER_TOKEN=change-me-too
ANTRO_STATE_PATH=.antroswarm/state.json
ANTRO_AGENT_STALE_MS=300000
ANTRO_DEFAULT_RESERVATION_TTL_MS=1800000
ANTRO_RUNNER_TIMEOUT_MS=120000

# Local runner
ANTRO_CLOUD_URL=https://your-antroswarm.example.com
ANTRO_WORKSPACE=D:\\path\\to\\your\\repo
ANTRO_RUNNER_ID=antropov-pc
ANTRO_BASE_REF=origin/main
ANTRO_BUILD_COMMAND=gradlew.bat clean build
ANTRO_RUNNER_ALLOW_EXEC=false
ANTRO_RUNNER_ALLOWED_PREFIXES=git,npm,npx,pnpm,yarn,gradle,gradlew,gradlew.bat,mvn,mvnw
# Optional. Defaults to a sibling .antroswarm-worktrees directory.
# ANTRO_WORKTREE_ROOT=D:\\worktrees\\antroswarm
