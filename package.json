{
  "name": "antroswarm",
  "version": "0.3.0",
  "description": "Shared MCP coordination plane + outbound local runner for multiple independent coding-agent chats.",
  "type": "module",
  "bin": { "antroswarm": "./dist/src/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts serve",
    "start": "node dist/src/index.js serve",
    "runner": "node dist/src/index.js runner",
    "test": "tsx --test tests/coordinator.test.ts tests/command-queue.test.ts",
    "check": "npm run build && npm test"
  },
  "keywords": ["mcp", "multi-agent", "coding-agent", "swarm", "chatgpt", "codex", "git-worktree"],
  "author": "Antropov31",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "minimatch": "^10.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
